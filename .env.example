# Server only. Optional; all local workflows work without it.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Maximum number of paid image requests per month (not a dollar estimate).
AI_MONTHLY_REQUEST_LIMIT=10
PYTHON_PATH=python
# Absolute directory; default: ./data. Restart after changing.
BOOKSTUDIO_DATA_DIR=
# Optional absolute output directory, default: data/exports. Restart after changing.
BOOKSTUDIO_OUTPUT_DIR=
BOOKSTUDIO_ORIGIN=http://127.0.0.1:3000
